# Broker Gateway Configuration
# Credenciais de corretora NÃO ficam aqui — são fornecidas pelo frontend
# no momento da criação da conexão (POST /connections com email/password no body).
PORT=8000
HOST=0.0.0.0

# Security
SECRET_KEY=your-secret-key-change-in-production
BROKER_ENCRYPTION_KEY=change-this-to-a-secure-random-string

# Supabase (Required for persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Redis (optional)
REDIS_URL=redis://localhost:6379

# B3 via API local MetaTrader 5 (broker "mt5" — somente dados)
# URL base da API b3-mt5-api rodando na VPS Windows ao lado do MT5 da Toro.
# Local: http://127.0.0.1:8001 | Produção (CONNECTOR em container): use o
# IP da VPS na rede interna, ex.: http://10.0.0.5:8001
MT5_API_URL=http://127.0.0.1:8001

# Conta para teste do IQOption (usada para testes de integração com o IQOption)
IQOPTION_TEST_ACCOUNT_ID=195844924
IQOPTION_TEST_EMAIL=99tisistemas@gmail.com
IQOPTION_TEST_PASSWORD=@seguro#LIVE332