# Broker Gateway Configuration
PORT=8000
HOST=0.0.0.0

# IQ Option Credentials (USE PRACTICE ACCOUNT FOR TESTING)
IQOPTION_EMAIL=your_email@example.com
IQOPTION_PASSWORD=your_password
IQOPTION_ACCOUNT_TYPE=practice

# Security
SECRET_KEY=your-secret-key-change-in-production

# Database (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/broker_gateway

# Redis (optional)
REDIS_URL=redis://localhost:6379