# Broker Gateway Configuration
PORT=8000
HOST=0.0.0.0

# IQ Option Credentials (USE PRACTICE ACCOUNT FOR TESTING)
IQOPTION_EMAIL=your_email@example.com
IQOPTION_PASSWORD=your_password
IQOPTION_ACCOUNT_TYPE=practice

# Security
SECRET_KEY=your-secret-key-change-in-production
BROKER_ENCRYPTION_KEY=change-this-to-a-secure-random-string

# Supabase (Required for persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Redis (optional)
REDIS_URL=redis://localhost:6379